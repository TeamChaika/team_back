# Copy to .env.assistant (ignored by Git) and fill the API key there.
CHAIKA_AI_PROVIDER=openrouter
CHAIKA_AI_API_KEY=
CHAIKA_AI_MODEL=openai/gpt-5.4-mini
CHAIKA_AI_REQUESTS_PER_HOUR=20
CHAIKA_AI_MAX_OUTPUT_TOKENS=1800

# For a Timeweb agent set PROVIDER=timeweb and use its Access ID (UUID),
# not the numeric ID from the control panel. Put its API key in API_KEY above.
# Choose GPT-5.4 Mini in the agent settings; MODEL is the site's model label.
# CHAIKA_AI_PROVIDER=timeweb
# CHAIKA_AI_TIMEWEB_AGENT_ID=
# CHAIKA_AI_MODEL=gpt-5.4-mini
