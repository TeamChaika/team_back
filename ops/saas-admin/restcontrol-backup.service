[Unit]
Description=Consistent private RestControl PostgreSQL snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=restcontrol-saas
Group=restcontrol-saas
WorkingDirectory=/opt/restcontrol-saas/current/backend
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/opt/restcontrol-saas/runtime.env
UMask=0077
ExecStart=/bin/sh -c 'exec /opt/restcontrol-saas/venv/bin/python -m app.saas_admin backup --data-dir /opt/restcontrol-saas/data --output "/opt/restcontrol-saas/backups/registry-$(date -u +%%Y%%m%%dT%%H%%M%%S)" --clear-sessions'
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/restcontrol-saas/backups
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LimitCORE=0
MemoryMax=256M
