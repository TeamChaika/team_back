[Unit]
Description=Private support schema PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/libexec/restcontrol-support-backup
TimeoutStartSec=300
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/restcontrol-support-backups
RestrictAddressFamilies=AF_UNIX
LimitCORE=0
StandardOutput=null
StandardError=null
