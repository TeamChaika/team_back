CHAIKA_APP_NAME="Chaika Team API"
# Отдельная роль backend через локальный SSH-туннель; пароль хранится только в .env.
CHAIKA_DATABASE_URL=
# Ключ заголовка X-Sync-Key для запуска обновления и просмотра задания.
CHAIKA_SYNC_API_KEY=

# Полный адрес API, например https://your-server.example/resto/api
CHAIKA_IIKO_BASE_URL=
CHAIKA_IIKO_LOGIN=
# Обычный пароль: приложение само вычисляет SHA1 для протокола iikoServer.
CHAIKA_IIKO_PASSWORD=
# Необязательно: файл дополнительных подключений, путь от backend/.
# Образец: config/iiko-connections.example.json. Рабочий файл храните вне Git.
CHAIKA_IIKO_CONNECTIONS_FILE=
# Для контейнера вместо файла: JSON в формате config/iiko-connections.example.json.
CHAIKA_IIKO_CONNECTIONS_JSON=
# Включает фоновый планировщик и закрытый технический API на 127.0.0.1:8010.
CHAIKA_SYNC_ENABLED=false
# Сегодняшние продажи напрямую из iiko, общий кеш процесса на 5–10 минут.
CHAIKA_LIVE_SALES_ENABLED=false
CHAIKA_LIVE_SALES_CACHE_SECONDS=300
CHAIKA_IIKO_TIMEOUT_SECONDS=15
CHAIKA_IIKO_PRODUCTS_TIMEOUT_SECONDS=180
CHAIKA_IIKO_GROUPS_TIMEOUT_SECONDS=60
CHAIKA_IIKO_ASSEMBLY_TIMEOUT_SECONDS=30
CHAIKA_IIKO_ALL_ASSEMBLY_TIMEOUT_SECONDS=180
CHAIKA_IIKO_ALL_ASSEMBLY_MAX_RESPONSE_BYTES=134217728
CHAIKA_IIKO_INVOICES_TIMEOUT_SECONDS=60
CHAIKA_IIKO_STORES_TIMEOUT_SECONDS=30
CHAIKA_IIKO_BALANCES_TIMEOUT_SECONDS=60
CHAIKA_IIKO_STORE_BALANCES_TIMEOUT_SECONDS=60
CHAIKA_IIKO_EMPLOYEES_TIMEOUT_SECONDS=60
CHAIKA_IIKO_WRITEOFFS_TIMEOUT_SECONDS=60
CHAIKA_IIKO_CASH_SHIFTS_TIMEOUT_SECONDS=60
CHAIKA_IIKO_OLAP_COLUMNS_TIMEOUT_SECONDS=30
CHAIKA_IIKO_OLAP_SALES_TIMEOUT_SECONDS=60

# Отдельный сайт (app.portal:app). Ключ anon/publishable, НЕ service_role.
CHAIKA_WEB_SUPABASE_URL=https://your-supabase.example
CHAIKA_WEB_ANON_KEY=
CHAIKA_WEB_ORIGIN=http://127.0.0.1:8013
# При публикации через HTTPS обязательно true.
CHAIKA_WEB_SECURE_COOKIE=false

# Собранный фронтенд из отдельного соседнего репозитория. Можно задать абсолютный путь.
CHAIKA_WEB_FRONTEND_DIR=../team_front/dist
